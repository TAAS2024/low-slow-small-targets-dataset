# ============================================================
# 低慢小数据集生成架构 — LLM Parser 环境配置
# ============================================================
# 复制此文件为 .env 并填入你的 API Key
#   cp .env.example .env
#
# 支持三种 LLM 后端，至少配置一个即可：
# ============================================================

# --- DeepSeek (推荐) ---
# 获取 Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- OpenAI ---
# 获取 Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic Claude ---
# 获取 Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================================
# Web 服务配置
# ============================================================
FLASK_HOST=
FLASK_PORT=
FLASK_DEBUG=
