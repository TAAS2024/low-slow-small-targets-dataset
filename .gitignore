# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets — never commit a real .env
.env
*.env
!*.env.example

# Generated images and runtime artefacts
output_images/
*.log

# Model weights, datasets and the background pool.
# These directories exist in the original project tree and are deliberately
# NOT tracked: the weights are ~22 GB and the background pool ~11 GB.
0-model
1-background-pool
*.safetensors
*.ckpt
*.bin
*.pth

# LoRA adapters / kohya training outputs — the training *code* is tracked,
# the produced weights and demo frames are not.
2-Lora training/best_models/
2-Lora training/demo_output*/
2-Lora training/drn3_pocket_uav/
0-database/kohya_dataset/output/
0-database/11_drone_clean/
0-database/Drone_pic/
0-database/官方数据集/
0-database/lora_logs_v3_768/

# ... except the small BRISQUE SVM weights that V6 needs to run (115 KB)
!6-Validator/**/models/*.pt

# Per-sample dumps and intermediate runs (regenerable, large)
experiments/**/manifest.json
experiments/**/samples/
experiments/**/_smoke*/
experiments/**/_scratch/
experiments/**/_v8_prework/
experiments/**/_v9_prehalofix/
experiments/**/*_buggy_*
experiments/**/*_stale_*
experiments/**/*_partial_*
experiments/**/crops/

# Research notes, task lists and manuscript working documents.
# These sit next to the code in the research tree but are not part of the
# architecture, so the whole directories are kept out of the repository.
·重点节点总结笔记/
参考资料/
·-1豆包案例图/
z-文件格式参考/

