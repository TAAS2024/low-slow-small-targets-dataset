# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets — never commit a real .env
.env
*.env
!*.env.example

# Generated images and runtime artefacts
output_images/
*.log

# Model weights of any kind — this repository carries code only
*.safetensors
*.ckpt
*.bin
*.pth
*.pt

# The original research tree. The archive holds the final version of every
# module; the trees below hold the iterations that led there, and are kept on
# disk only. Ignoring them wholesale also stops a checkout that lives inside
# the project root from re-adding them by accident.
0-model/
1-background-pool/
0-database/
2-Lora training/
3-LLM starter/
4-Transformer/
5-Controlnet/
6-Validator/
experiments/**/output_images/

# Working documents: notes, manuscript drafts, tutor-feedback audits,
# third-party reference material.
·重点节点总结笔记/
参考资料/
·-1豆包案例图/
z-文件格式参考/

# Per-sample dumps and intermediate runs (regenerable, large)
experiments/**/manifest.json
experiments/**/samples/
experiments/**/_smoke*/
experiments/**/_scratch/
experiments/**/_v8_prework/
experiments/**/_v9_prehalofix/
experiments/**/*_buggy_*
experiments/**/*_stale_*
experiments/**/*_partial_*
experiments/**/crops/

