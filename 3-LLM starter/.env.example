# ════════════════════════════════════════════════════════════
# 低慢小数据集生成架构 — Web 前端环境变量模板
# ════════════════════════════════════════════════════════════
# 用法：cp .env.example .env  然后把下面的占位符换成真实 Key。
# ⚠️ .env 已被 gitignore，切勿提交真实密钥。
# 只需要填**其中一个** LLM 后端的 Key 即可；一个都没有时请用
# 界面上的 "Dry-Run (离线)" 后端。
# ════════════════════════════════════════════════════════════

# ── LLM 后端（至少填一个）──────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选：覆盖默认模型名 ───────────────────────────────────
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Web 服务 ───────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# ⚠️ 必须保持 false：debug 热重载会 fork 第二个进程，导致模型被加载两次、显存翻倍
FLASK_DEBUG=false

# 会话内存上限（超出后淘汰最旧的会话）
MAX_SESSIONS=200

# ── 管线 / 显存 ────────────────────────────────────────────
# 本机到 huggingface.co 不可达时必须开启，否则每次调用都要等 etag 校验重试
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# 8 GB 卡上的碎片化会导致假死
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ── 背景检索 ───────────────────────────────────────────────
# labels = 按 time_of_day / weather 标签匹配（默认，读 _metadata.jsonl）
# random = 旧行为，纯随机（复现历史数据集用）
BG_MATCH=labels
